<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Profil Curier - CYPRES</title><style>*{margin:0;box-sizing:border-box}body{font-family:sans-serif;background:#111;color:#fff;padding:16px}header{background:#0f3d2e;padding:12px;border-radius:12px;display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}a{color:#ffcc00;text-decoration:none;font-weight:900}.card{background:#222;border-radius:16px;padding:16px;margin-bottom:12px}.avatar{width:90px;height:90px;border-radius:50%;background:#333;display:flex;align-items:center;justify-content:center;font-size:40px;margin:0 auto 10px;overflow:hidden}.avatar img{width:100%;height:100%;object-fit:cover}input,select{width:100%;padding:12px;border-radius:10px;border:0;background:#333;color:#fff;margin-top:6px;margin-bottom:12px}label{font-size:12px;color:#aaa;font-weight:700}.stat{display:flex;justify-content:space-between;background:#333;padding:10px 12px;border-radius:10px;margin-top:8px}.btn{width:100%;padding:14px;border-radius:12px;border:0;font-weight:900;margin-top:10px}.green{background:#25D366;color:#fff}.yellow{background:#ffcc00;color:#000}.badge{background:#0f3d2e;color:#25D366;padding:4px 10px;border-radius:20px;font-size:11px}</style></head><body>
<header><a href="index.html">← ÎNAPOI</a><b>PROFIL CURIER</b><span class="badge">● ONLINE</span></header>

<div class="card" style="text-align:center">
<div class="avatar" id="av" onclick="document.getElementById('file').click()">👤</div>
<input type="file" id="file" hidden accept="image/*" onchange="loadImg(event)">
<h2 id="numeView">Nume Curier</h2><p style="color:#aaa;font-size:12px" id="telView">Telefon</p>
</div>

<div class="card">
<label>NUME COMPLET</label><input id="nume" placeholder="Ex: Calin Nac" oninput="save()">
<label>TELEFON</label><input id="tel" placeholder="Ex: +34 6XX XXX XXX" oninput="save()">
<label>VEHICUL</label><select id="veh" onchange="save()"><option>🛵 Scuter</option><option>🚲 Bicicleta</option><option>🏍️ Moto mare</option><option>🚗 Masina</option></select>
<label>ZONA VALENCIA</label><select id="zona" onchange="save()"><option>Centro</option><option>Ruzafa</option><option>El Pla del Remei</option><option>Camins al Grau</option><option>Poblats Maritims</option><option>Toata Valencia</option></select>
<label>NUMAR INMATRICULARE</label><input id="plate" placeholder="Ex: 1234 LLL" oninput="save()">
<button class="btn green" onclick="save();alert('Profil salvat! ✅')">💾 SALVEAZA PROFIL</button>
</div>

<div class="card">
<b>📊 STATISTICI AZI</b>
<div class="stat"><span>Livrari azi</span><b id="s1">12</b></div>
<div class="stat"><span>Castig azi</span><b id="s2">87€</b></div>
<div class="stat"><span>Rating ⭐</span><b>4.9 / 5</b></div>
<div class="stat"><span>Timp mediu</span><b>18 min</b></div>
<button class="btn yellow" onclick="if(confirm('Resetezi statisticile?')){localStorage.clear();location.reload()}">RESET</button>
</div>

<script>
function loadImg(e){let r=new FileReader();r.onload=function(){document.getElementById('av').innerHTML=`<img src="${r.result}">`;localStorage.setItem('av',r.result)};r.readAsDataURL(e.target.files[0])}
function save(){let d={nume:document.getElementById('nume').value,tel:document.getElementById('tel').value,veh:document.getElementById('veh').value,zona:document.getElementById('zona').value,plate:document.getElementById('plate').value};localStorage.setItem('curier',JSON.stringify(d));document.getElementById('numeView').innerText=d.nume||'Nume Curier';document.getElementById('telView').innerText=(d.veh||'')+' • '+(d.zona||'')+' • '+(d.tel||'');}
let s=JSON.parse(localStorage.getItem('curier')||'{}');if(s.nume){document.getElementById('nume').value=s.nume;document.getElementById('tel').value=s.tel;document.getElementById('veh').value=s.veh;document.getElementById('zona').value=s.zona;document.getElementById('plate').value=s.plate;save()}let av=localStorage.getItem('av');if(av)document.getElementById('av').innerHTML=`<img src="${av}">`;
</script></body></html>
